<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0" prefWidth="560.0" spacing="10.0" style="-fx-padding: 15;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="umu.tds.vista.HistorialControllerView">
   <children>
      <Label style="-fx-font-weight: bold;" text="Historial de notificaciones:" />
      <TableView fx:id="tablaHistorial" prefHeight="330.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="fechaCol" prefWidth="110" text="Fecha" />
            <TableColumn fx:id="mensajeCol" prefWidth="420" text="Mensaje" />
         </columns>
      </TableView>
      <HBox alignment="CENTER_RIGHT">
         <Button onAction="#cerrar" text="Cerrar" />
      </HBox>
   </children>
</VBox>
