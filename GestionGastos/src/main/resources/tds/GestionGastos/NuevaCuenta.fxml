<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="370.0" prefWidth="400.0" spacing="10.0" style="-fx-padding: 15;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="umu.tds.vista.NuevaCuentaControllerView">
   <children>
      <Label text="Nombre de la cuenta:" />
      <TextField fx:id="nombreField" promptText="Nombre de la cuenta" />
      <Label text="Tipo de cuenta:" />
      <ComboBox fx:id="tipoCombo" prefWidth="220.0" />
      <Label fx:id="instruccionesLabel" />
      <TextArea fx:id="participantesArea" prefHeight="140.0" wrapText="true" />
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button defaultButton="true" onAction="#crearCuenta" text="Crear cuenta" />
            <Button onAction="#cancelar" text="Cancelar" />
         </children>
      </HBox>
   </children>
</VBox>
