<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="500.0" prefWidth="1200.0" spacing="8.0" style="-fx-padding: 10; -fx-font-family: monospace;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="umu.tds.vista.VistaInterpreteControllerView">
   <children>
      <TextArea fx:id="salidaArea" editable="false" prefHeight="350.0" style="-fx-font-family: monospace;" wrapText="true" VBox.vgrow="ALWAYS" />
      <HBox spacing="8.0">
         <children>
            <TextField fx:id="entradaField" promptText="Escribe un comando..." style="-fx-font-family: monospace;" HBox.hgrow="ALWAYS" />
            <Button onAction="#ejecutarComando" text="Ejecutar" />
         </children>
      </HBox>
   </children>
</VBox>
