<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="560.0" spacing="10.0" style="-fx-padding: 15;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="umu.tds.vista.AlertasControllerView">
   <children>
      <Label style="-fx-font-weight: bold;" text="Alertas configuradas:" />
      <TableView fx:id="tablaAlertas" prefHeight="220.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="tipoCol" prefWidth="90" text="Tipo" />
            <TableColumn fx:id="limiteCol" prefWidth="95" text="Limite (€)" />
            <TableColumn fx:id="categoriaCol" prefWidth="130" text="Categoria" />
            <TableColumn fx:id="estadoCol" prefWidth="120" text="Estado" />
         </columns>
      </TableView>
      <Button onAction="#eliminarAlerta" text="Eliminar alerta seleccionada" />

      <Separator />

      <Label style="-fx-font-weight: bold;" text="Nueva alerta:" />
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <ComboBox fx:id="tipoCombo" prefWidth="110.0" promptText="Tipo" />
            <TextField fx:id="limiteField" prefWidth="90.0" promptText="Limite" />
            <ComboBox fx:id="categoriaCombo" prefWidth="140.0" promptText="Categoria" />
            <Button defaultButton="true" onAction="#crearAlerta" text="Crear" />
         </children>
      </HBox>

      <Separator />

      <HBox alignment="CENTER_RIGHT">
         <Button onAction="#cerrar" text="Cerrar" />
      </HBox>
   </children>
</VBox>
